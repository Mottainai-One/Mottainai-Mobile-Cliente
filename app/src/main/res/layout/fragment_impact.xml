<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_beige">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">
        <include
            layout="@layout/include_brand_header" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Sua jornada Mottainai"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Sua participação é representada pelos pontos de fidelidade de compras confirmadas pelo mercado."
            android:textColor="@color/text_grey"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/impact_availability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/text_grey" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:padding="20dp"
            android:background="@drawable/bg_map_placeholder">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pontos de fidelidade"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/impact_points"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="— pts"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green" />
            <TextView
                android:id="@+id/impact_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nível ainda não informado"
                android:textSize="18sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/impact_next_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_grey" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:text="Cada real gasto em compras confirmadas gera um ponto. Cancelamentos e devoluções retiram os pontos correspondentes. Clientes com mais pontos recebem comunicações de melhores promoções primeiro." />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_grey"
            android:text="Este nível representa participação no programa. Não é certificação ambiental nem medição de alimentos salvos ou CO₂ evitado. Pontos não são dinheiro e não podem ser resgatados neste MVP." />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/impact_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Atualizar pontos" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_impact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Compartilhar minha jornada"
            android:enabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>