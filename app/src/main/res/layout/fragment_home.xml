<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_beige"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/tv_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Olá!"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Vamos salvar algo gostoso hoje?"
            android:textColor="@color/text_grey"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/home_profile_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_grey"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_profile_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tentar novamente"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/home_points_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_banner_dark_green"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="SEUS PONTOS"
                android:textColor="@color/card_light_green"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_home_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="— pts"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_points_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Carregando saldo..."
            android:textColor="@color/text_grey" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_points_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tentar novamente"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_points_open"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver meus pontos"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Oportunidades disponíveis"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layout_featured_offers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/home_offers_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Carregando ofertas..."
            android:textColor="@color/text_grey" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_offers_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tentar novamente"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Lojas parceiras"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="150dp"
            android:background="@drawable/bg_map_placeholder">

            <com.mottainai.cliente.widgets.PartnerMapView
                android:id="@+id/map_preview"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:text="© OpenStreetMap contributors"
                android:textColor="@color/primary_green_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_nearest_store"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_pill_rounded"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="Carregando lojas..."
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_stores_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tentar novamente"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_stores_open"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver todas as lojas"
            android:textAllCaps="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
