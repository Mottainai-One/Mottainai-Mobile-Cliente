<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style
        name="Widget.Client.Button"
        parent="Widget.Material3.Button">
        <item
            name="cornerRadius">16dp</item>
        <item
            name="android:minHeight">52dp</item>
        <item
            name="android:textAllCaps">false</item>
        <item
            name="android:textSize">15sp</item>
    </style>
    <style
        name="Widget.Client.Button.Secondary"
        parent="Widget.Material3.Button.OutlinedButton">
        <item
            name="cornerRadius">16dp</item>
        <item
            name="android:minHeight">52dp</item>
        <item
            name="android:textAllCaps">false</item>
        <item
            name="strokeColor">@color/divider_grey</item>
        <item
            name="android:textColor">@color/text_primary</item>
    </style>
    <style
        name="Widget.Client.Input"
        parent="Widget.AppCompat.EditText">
        <item
            name="android:background">@drawable/bg_input_field</item>
        <item
            name="android:backgroundTint">@null</item>
        <item
            name="android:minHeight">56dp</item>
        <item
            name="android:paddingHorizontal">16dp</item>
        <item
            name="android:paddingVertical">14dp</item>
        <item
            name="android:textColor">@color/text_primary</item>
        <item
            name="android:textColorHint">@color/text_grey</item>
        <item
            name="android:textSize">16sp</item>
    </style>
    <string
        name="client_brand">Mottainai</string>
    <string
        name="client_all_offers">Ver todas as ofertas</string>
    <string
        name="client_offer_image">Imagem do produto</string>
    <string
        name="client_open_store">Ver loja no Google Maps</string>
</resources>